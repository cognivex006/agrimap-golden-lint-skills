{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Explicit Golden provenance",
  "type": "object",
  "required": ["mode", "expectedVersion", "packageName", "activeVersion", "expectedReferenceCommit", "activeCommit", "activeTree", "selectedContentIdentity", "files", "dirty", "installedCompared"],
  "properties": {
    "mode": { "enum": ["checkout", "installed"] },
    "expectedVersion": { "type": "string" },
    "selectedContentIdentity": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "installedCompared": { "const": false },
    "files": { "type": "object" },
    "identitySource": { "enum": [null, "package.json", ".codex-plugin/plugin.json", ".claude-plugin/plugin.json", "gemini-extension.json", "plugin.json"] },
    "identityVerified": { "type": "boolean" },
    "versionMatched": { "type": "boolean" },
    "identitySources": { "type": "array", "items": { "type": "object", "required": ["path", "status", "digest"], "properties": { "path": { "enum": ["package.json", ".codex-plugin/plugin.json", ".claude-plugin/plugin.json", "gemini-extension.json", "plugin.json"] }, "status": { "enum": ["verified", "version-mismatch", "versionless", "mismatch", "invalid"] } } } }
  }
}
