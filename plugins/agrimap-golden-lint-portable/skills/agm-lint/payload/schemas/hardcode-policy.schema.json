{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgriMap hardcode policy ledger v1",
  "type": "object",
  "required": ["schemaVersion", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "entries": { "type": "array", "items": {
      "type": "object",
      "required": ["entryId", "previous", "subjectKey", "class", "tier", "path", "valueMask", "action", "owner", "reason", "evidence", "decidedOn", "reviewAfter", "snapshotIdentity"],
      "properties": {
        "entryId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "previous": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "subjectKey": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "class": { "enum": ["HC-SECRET", "HC-ENVURL", "HC-PROXYBYPASS", "HC-EXTURL", "HC-CONFIG", "HC-MAGIC", "HC-SQL"] },
        "tier": { "enum": ["MUST", "SHOULD"] },
        "path": { "type": "string", "pattern": "^(?!/)(?!.*\\\\)[^\\r\\n]+$" },
        "valueMask": { "type": "string", "minLength": 1, "maxLength": 512 },
        "action": { "enum": ["skip", "reopen"] },
        "owner": { "type": "string", "minLength": 1, "maxLength": 200 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 8000 },
        "evidence": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 2000 } },
        "decidedOn": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "reviewAfter": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "snapshotIdentity": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    } }
  }
}
