{
  "schemaVersion": 1,
  "pluginName": "agrimap-golden-lint-skills",
  "marketplaceName": "agrimap-golden-lint-skills",
  "repository": "https://github.com/orchex006/agrimap-golden-lint-skills",
  "description": "Read-only AgriMap Golden lint with Markdown reports and per-rule fix prompts",
  "sharedBundle": "plugins/agrimap-golden-lint-skills",
  "antigravityBundle": "plugins/agrimap-golden-lint-antigravity",
  "portableBundle": "plugins/agrimap-golden-lint-portable",
  "portableSkill": "plugins/agrimap-golden-lint-portable/skills/agm-lint",
  "hosts": {
    "codex": { "format": "marketplace-plugin", "bundle": "sharedBundle", "validation": "cli-grammar-and-bundle-only" },
    "claude": { "format": "marketplace-plugin", "bundle": "sharedBundle", "validation": "native-validator-available" },
    "gemini": { "format": "extension", "bundle": "sharedBundle", "validation": "structure-and-runner-only" },
    "antigravity": { "format": "plugin", "bundle": "antigravityBundle", "validation": "structure-and-runner-only" },
    "cursor": { "format": "marketplace-plugin", "bundle": "portableBundle", "validation": "structure-and-runner-only" },
    "antigravity-ide": { "format": "self-contained-skill", "bundle": "portableSkill", "validation": "structure-and-runner-only" },
    "agent-skills": { "format": "self-contained-skill", "bundle": "portableSkill", "validation": "structure-and-runner-only" }
  }
}
